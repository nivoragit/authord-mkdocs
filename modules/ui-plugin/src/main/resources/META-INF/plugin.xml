<idea-plugin>
    <id>com.authord.mkdocs.plugin</id>
    <name>Authord MkDocs Plugin</name>
    <vendor>Authord</vendor>
    <description>
        IntelliJ MkDocs MVP with extension-ready seams and plugin-shell entry points.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="markdown-toolbar.xml">org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Authord MkDocs Notifications" displayType="BALLOON" isLogByDefault="true" />
        <projectService serviceImplementation="com.authord.mkdocs.ui.intellij.PluginRuntimeIntegrationService" />
        <projectService serviceImplementation="com.authord.mkdocs.ui.intellij.MkDocsPreviewBrowserService" />
        <directoryIndexExcludePolicy implementation="com.authord.mkdocs.ui.intellij.MkdocsVenvDirectoryExcludePolicy" />
        <fileEditorManagerListener implementation="com.authord.mkdocs.ui.intellij.AuthordMarkdownOpenPreviewListener" />
        <fileEditorProvider implementation="com.authord.mkdocs.ui.intellij.AuthordMarkdownSplitEditorProvider" />
        <toolWindow
            id="Authord"
            factoryClass="com.authord.mkdocs.ui.intellij.MkdocsToolWindowFactory"
            anchor="right"
            canCloseContents="false"
        />

    </extensions>

    <actions>
        <action
            id="com.authord.mkdocs.action.startPreview"
            class="com.authord.mkdocs.ui.intellij.StartMkdocsAction"
            text="Start MkDocs Preview"
            description="Start MkDocs Preview for the active project"
        >
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
